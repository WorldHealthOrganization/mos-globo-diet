/******* QUANTIFICATION METHOD = % (Percentage) WHEN COMPUTED AUTOMATICALLY BY GLOBODIET *********/
  IF TYPE IN ('6','7','8') THEN Q_METHOD='%' ;
  IF (TYPE='4' AND Q_METHOD='?' AND CONS_QTY > 0) THEN Q_METHOD='%' ; 

