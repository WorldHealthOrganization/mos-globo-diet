* Age at recall date;
  AGEREC  = ROUND((DATE_REC - BIRTH_DATE)/365.25) ;

* Basal metabolic rate (BMR) ;
  IF (SEX = 1) THEN DO ;
     IF (AGEREC < 31) THEN 
        BMR = 15.4*WEIGHT - 27*HEIGHT/100 + 717 ; 
     IF (AGEREC >= 31 AND AGEREC <= 60) THEN 
        BMR = 11.3*WEIGHT + 16*HEIGHT/100 + 901 ; 
     IF (AGEREC > 60) THEN 
        BMR = 8.8*WEIGHT + 1128*HEIGHT/100 - 1071 ; 
    END;
  IF (SEX = 2) THEN DO ;
     IF (AGEREC < 31) THEN 
        BMR = 13.3*WEIGHT + 334*HEIGHT/100 + 35 ; 
     IF (AGEREC >= 31 AND AGEREC <= 60) THEN 
        BMR = 8.7*WEIGHT - 25*HEIGHT/100 + 865 ; 
     IF (AGEREC > 60) THEN 
        BMR = 9.2*WEIGHT + 637*HEIGHT/100 - 302 ; 
    END;

* Energy requirement recomputed;
  ENERGY_R = ROUND(BMR * 1.55) ;

* Body mass index (BMI);
  BMI      = WEIGHT/((HEIGHT/100)**2) ;

* 24H Recall Duration;
  WUNEXT   = (HOUR(WU_NEXT)*60) + MINUTE(WU_NEXT) + (24*60) ;
  WUREC    = (HOUR(WU_RECALL)*60) + MINUTE(WU_RECALL) ;
  DURREC   = ROUND((WUNEXT-WUREC)/60);

  *season;
  SEASONS2 = 2; IF MONTH(DATE_REC) IN (4,5,6,7,8,9) THEN SEASONS2=1;

  SEASONS4 = 3; IF MONTH(DATE_REC) IN (1,2,3) THEN SEASONS4=4 ;
		IF MONTH(DATE_REC) IN (4,5,6) THEN SEASONS4=1 ;
		IF MONTH(DATE_REC) IN (7,8,9) THEN SEASONS4=2 ;

 DAY_CL = . ;  IF DAY_REC IN (1,2,3,4) THEN DAY_CL = 1;
		IF DAY_REC IN (5,6,7)   THEN DAY_CL = 2;

