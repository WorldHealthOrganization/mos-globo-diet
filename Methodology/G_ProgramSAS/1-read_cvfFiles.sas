informat PRO_CODE     $255. ;    informat HEIGHT       best32. ;
informat PRO_LANGUAGE $5. ;      informat WEIGHT       best32. ;
informat COUNTRY      $3.;       informat BIRTH_DATE   DDMMYY10. ;
informat CENTER       $3.;       informat WU_RECALL    TIME5.0 ;
informat ID_NUM       $24.;      informat WU_NEXT      TIME5.0 ;
informat DATE_REC     DDMMYY10.; informat RECOMPUTE    DDMMYY10. ;
informat INT_NUM      best32.;   informat ENERGY_REQ   best32. ;
informat DAY_REC      best32.;   informat ENERG_CALC   best32. ;
informat SPDIET       $30.;      informat TIME_GI      TIME8.0 ;
informat SPDAY        $30.;      informat TIME_QL      TIME8.0 ;
informat COUNTRY_INT  $3. ;      informat TIME_DQ      TIME8.0 ;
informat CENTER_INT   $3. ;      informat TIME_DS      TIME8.0 ;
informat CODE_INT     $20.;      informat TIME_ALL     TIME8.0 ;
informat INT_DATE     DDMMYY10.; informat ITV_ID       best32. ;
informat INT_DAY      best32.;   informat VERSION      $255. ;
informat PAT_NAME     $100.;     informat PRO_COUNTRY  $3. ;
informat PAT_FNAME    $100.;     informat PRO_RELEASE  DDMMYY10. ;
informat SEX          $1.;	

INPUT ITV_ID      COUNTRY $     CENTER $     ID_NUM $    INT_NUM     DATE_REC      DAY_REC     SPDIET $    SPDAY $
      CODE_INT $  INT_DATE      INT_DAY      PAT_NAME $  PAT_FNAME $ SEX $         HEIGHT      WEIGHT      BIRTH_DATE
      WU_RECALL   WU_NEXT       RECOMPUTE    ENERGY_REQ  ENERG_CALC  TIME_GI       TIME_QL     TIME_DQ     TIME_DS
      TIME_ALL    COUNTRY_INT $ CENTER_INT $ VERSION $   PRO_CODE $  PRO_COUNTRY $ PRO_RELEASE PRO_LANGUAGE $ ;

FORMAT 
 DATE_REC INT_DATE BIRTH_DATE RECOMPUTE PRO_RELEASE MMDDYY10. 
 COUNTRY $Country.
 DAY_REC INT_DAY Dayoweek.
 SPDIET  $Spdiet.
 SPDAY   $Spday.
 SEX     $Gender. ;
RUN;

