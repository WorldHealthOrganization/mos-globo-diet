  IF PROPORT='2/8'  THEN PROP='0.2500'; IF PROPORT='3/1'  THEN PROP='3.0000';
  IF PROPORT='3/10' THEN PROP='0.3000'; IF PROPORT='3/2'  THEN PROP='1.5000';
  IF PROPORT='3/4'  THEN PROP='0.7500'; IF PROPORT='3/5'  THEN PROP='0.6000';
