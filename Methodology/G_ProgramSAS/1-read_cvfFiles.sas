informat CENTER       $3.;         informat I_TYPE       $2.;
informat ID_NUM       $24.;        informat R_MODIF      1.;
informat DATE_REC     DDMMYY10.;   informat I_MODIF      1.;
informat FCO          $2.;         informat FOODNUM      $5.;
informat HOUR         $5.;         informat GROUP SUBGROUP1 SUBGROUP2 $2.;
informat POC          $2.;         informat LABEL        $255. ; 
informat TOK          best32.;     informat Q_METHOD     $1.;
informat QLINUM       best32.;     informat MAX QLI_EMPTY  1.;
informat ING_NUM      best32.;     informat NOTE_TYPE    $5.;
informat S_ING_NUM    best32.;     informat NOTE_STATUS  $3.;
informat TYPE         $2.;         informat NOTES        $32767.; 
informat F_TYPE       $2.;         informat NOTE_DATE    DDMMYY10. ;
informat DB_NAME      $50.;

INPUT DB_NAME $  ID_NUM $    DATE_REC      FCO $   HOUR $      POC $       TOK      QLINUM     ING_NUM    TYPE $   
      F_TYPE $   R_TYPE $    FOODNUM $     GROUP $ SUBGROUP1 $ SUBGROUP2 $ LABEL $  CONS_QTY   Q_METHOD $ MAX      
      QLI_EMPTY  NOTE_TYPE $ NOTE_STATUS $ NOTES $ NOTE_DATE   COUNTRY $   CENTER $ S_ING_NUM  I_TYPE $   R_MODIF  I_MODIF ;

/********************** correction of wrong ID codes ******************************/
/* IF (ID_NUM='20102') THEN ID_NUM='201020';
 IF DATE_REC=MDY(04,23,2014) THEN DATE_REC=MDY(05,22,2014);
 IF (ID_NUM='020205') and DATE_REC=MDY(01,11,2014) THEN DO;
   ID_NUM='010102'; DATE_REC=MDY(11,10,2014); 
 END;*/

FORMAT 
 DATE_REC    MMDDYY10. 
 COUNTRY     $Country.
 FCO         $FCO.
 POC         $POC.
 TYPE        $TYPE. 
 F_TYPE      $Ftype. 
 R_TYPE      $Rtype.
 I_TYPE      $Itype. 
 R_MODIF     Rmod.
 I_MODIF     Imod.
 Q_METHOD    $Qmethod.
 MAX         YN.
 QLI_EMPTY   YN.
 NOTE_TYPE   $NTYPE. 
 NOTE_STATUS $NSTATUS. ;

LABEL
 COUNTRY       = 'Country code'
 CENTER        = 'Region/center code'
 ID_NUM        = 'Subject Code'
 DATE_REC      = 'Recall Date'
 FCO           = 'Food consumption occasion (FCO)'
 HOUR          = 'FCO hour minute'
 POC           = 'Place of FCO'
 TOK           = 'Quick List Item Code '
 QLINUM        = 'Sequential Number Within the Quick List Item (QLI)'
 ING_NUM       = 'Sequential Number within a Mixed Recipe for Ingredients'
 S_ING_NUM     = 'Sequential Number for Ingredients within a Sub-Recipe '
 TYPE          = 'Type of record'
 F_TYPE        = 'Food Type'
 R_TYPE        = 'Recipe Type'
 I_TYPE        = 'Ingredient Type'
 R_MODIF       = 'Type of modification on for rcp'
 I_MODIF       = 'Type of modification done on ingr.'
 FOODNUM       = 'Food or Recipe or Ingredient'
 GROUP         = 'Food, Recipe or Ingr. Group'
 SUBGROUP1     = 'Food or Recipe or Ingr. Sub-Group'
 SUBGROUP2     = 'Food or Ingr. Sub-Sub-Group'
 LABEL         = 'Item label'
 Q_METHOD      = 'Quantification method'
 CONS_QTY      = 'Consumed quantity in grams'
 MAX           = 'Maximum value exceeded'
 QLI_EMPTY     = 'Empty quick-list item'
 DB_NAME       = 'Database name'
 NOTE_TYPE     = 'Type of Note '
 NOTE_STATUS   = 'State of the art of the note'
 NOTES         = 'Reported Note Text'
 NOTE_DATE     = 'Date of last note update';
RUN;


