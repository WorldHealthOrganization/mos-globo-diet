  IF PROPORT='5/4'  THEN PROP='1.2500'; IF PROPORT='5/6'  THEN PROP='0.8333';
  IF PROPORT='6/3'  THEN PROP='2.0000'; IF PROPORT='6/4'  THEN PROP='1.5000';
  IF PROPORT='6/5'  THEN PROP='1.2000'; IF PROPORT='7/2'  THEN PROP='3.5000';
