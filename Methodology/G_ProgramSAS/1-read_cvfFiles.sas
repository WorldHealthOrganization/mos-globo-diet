  IF (SUBSTR(HOUR,1,3) EQ '+10') THEN HOURS='33' ;
  IF (SUBSTR(HOUR,1,3) EQ '+11') THEN HOURS='33' ;
  IF (SUBSTR(HOUR,1,3) EQ '+99') THEN HOURS='99' ;
